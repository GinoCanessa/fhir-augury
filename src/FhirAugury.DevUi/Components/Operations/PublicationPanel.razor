@using System.Globalization
@using FhirAugury.Processor.Jira.Fhir.Preparer.Contracts
@using FhirAugury.Publishing.Tickets

<section class="operation-panel publication-panel"
         aria-labelledby="@HeadingId">
    <div class="operation-panel__heading">
        <div>
            <p class="operation-panel__eyebrow">Separate local step</p>
            <h2 id="@HeadingId" class="h4 mb-0">
                Review-site publication
            </h2>
        </div>
        <StatusIndicator Status="@PublicationStatus"
                         Label="@PublicationLabel" />
    </div>

    <div class="processor-result-reminder">
        <strong>Processor result:</strong>
        <span>@ProcessorResultLabel</span>
    </div>

    @if (Details.Outcome.Processor ==
        ProcessorRunOutcome.Completed)
    {
        <div class="publication-readiness publication-readiness--full">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <div>
                <strong>Full processor success.</strong>
                All tickets completed; the verified snapshot is eligible
                for publication.
            </div>
        </div>
    }
    else if (Details.Outcome.Processor ==
        ProcessorRunOutcome.CompletedWithSupersededItems)
    {
        <div class="publication-readiness publication-readiness--partial">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div>
                <strong>Partial processor success.</strong>
                The following tickets were explicitly superseded and will
                not appear as completed output:
            </div>
        </div>
        <ul class="superseded-publication-list">
            @foreach (AuthoringRunItemStatus item in SupersededItems)
            {
                <li>
                    <a href="@ItemViewerUrl.For("jira", item.BusinessKey)">
                        @item.BusinessKey
                    </a>
                    <span>
                        @(string.IsNullOrWhiteSpace(item.SupersessionReason)
                            ? "No reason was returned by the processor."
                            : item.SupersessionReason)
                    </span>
                </li>
            }
        </ul>
    }

    @if (Details.Outcome.Processor ==
        ProcessorRunOutcome.CompletedDatabaseOnly)
    {
        <div class="callout callout--neutral">
            <i class="bi bi-database-check" aria-hidden="true"></i>
            <div>
                <strong>Database-only output selected.</strong>
                This successful run intentionally has no immutable snapshot
                to download and no review site to generate.
            </div>
        </div>
    }
    else if (Details.Outcome.Processor is
        ProcessorRunOutcome.Active or
        ProcessorRunOutcome.RecoverableError)
    {
        <p class="text-body-secondary">
            Site generation becomes available after the processor completes
            a snapshot-producing run.
        </p>
    }
    else if (Details.Outcome.Processor ==
        ProcessorRunOutcome.Superseded)
    {
        <p class="text-body-secondary">
            A superseded run cannot be published.
        </p>
    }

    @if (Details.Workflow.SiteKind == TicketSiteKind.Discussion &&
        Details.Response.Run.CorpusComparison is
            AuthoringRunCorpusComparison comparison)
    {
        <div class="callout @(comparison.AdditionalTicketCount > 0 ? "callout--warning" : "callout--neutral") publication-corpus-comparison">
            <i class="bi bi-files" aria-hidden="true"></i>
            <div>
                <h3 class="h6">Frozen refresh corpus comparison</h3>
                <dl class="row mb-2">
                    <dt class="col-sm-6">Source snapshot</dt>
                    <dd class="col-sm-6"><code>@comparison.SourceSnapshotId</code></dd>
                    <dt class="col-sm-6">Source exported tickets</dt>
                    <dd class="col-sm-6">@comparison.SourceExportedTicketCount</dd>
                    <dt class="col-sm-6">Current accepted tickets</dt>
                    <dd class="col-sm-6">@comparison.CurrentAcceptedTicketCount</dd>
                    <dt class="col-sm-6">Additional current tickets</dt>
                    <dd class="col-sm-6">@comparison.AdditionalTicketCount</dd>
                </dl>
                @if (comparison.AdditionalTicketCount > 0)
                {
                    <p class="mb-1">
                        <strong>Additional current output is included.</strong>
                        This refresh includes @comparison.AdditionalTicketCount
                        tickets beyond the source snapshot's exported corpus.
                        It is not an identical-membership republication.
                    </p>
                }
                else
                {
                    <p class="mb-1">No additional current tickets are included.</p>
                }
                <p class="mb-0">
                    These persisted counts describe the frozen accepted corpus,
                    not the run's completed-item count. Publication remains a
                    separate step after the refresh completes.
                </p>
            </div>
        </div>
    }

    @if (Publication is ReviewSitePublication publication)
    {
        <div class="publication-location">
            <div>
                <span class="publication-location__label">
                    Run-scoped output
                </span>
                <code>@publication.Coordinates.SiteDirectory</code>
            </div>
            <a class="btn btn-success"
               href="@publication.Coordinates.SiteUrl"
               target="_blank"
               rel="noopener">
                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                Open review site
            </a>
        </div>
    }

    @if (Publication is ReviewSitePublication discussionPublication &&
        Details.Workflow.SiteKind == TicketSiteKind.Discussion)
    {
        DiscussionPublicationReadiness? readiness =
            discussionPublication.Manifest.DiscussionReadiness;
        <h3 class="h6">Provenance readiness</h3>
        @if (readiness is null)
        {
            <div class="callout callout--warning publication-readiness-evidence">
                <i class="bi bi-exclamation-circle-fill"
                   aria-hidden="true"></i>
                <div>
                    <strong>Publication readiness is not recorded.</strong>
                    This legacy manifest predates structured readiness
                    evidence, so Jira provenance and public-display-name
                    policy proof are unknown.
                </div>
            </div>
        }
        else if (readiness.IsReady)
        {
            <div class="publication-readiness publication-readiness--full publication-readiness-evidence">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <div>
                    <strong>Publication readiness is verified.</strong>
                    Evidence: <code>@readiness.Evidence</code>.
                </div>
            </div>
        }
        else
        {
            <div class="callout callout--warning publication-readiness-evidence">
                <i class="bi bi-exclamation-circle-fill"
                   aria-hidden="true"></i>
                <div>
                    <strong>Publication readiness is degraded.</strong>
                    Jira provenance or public-display-name policy proof is
                    unavailable:
                    <ul class="mb-0">
                        @foreach (DiscussionPublicationReadinessReason reason
                            in readiness.Reasons)
                        {
                            <li>
                                <code>@reason.Code</code>:
                                @reason.Message
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        <p class="text-body-secondary">
            Proof readiness does not establish complete public names or links.
            Upstream Jira last successful refresh (provenance):
            @if (discussionPublication.Manifest.JiraSourceLastSuccessfulRefreshAt
                is DateTimeOffset sourceRefresh)
            {
                <time datetime="@sourceRefresh.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">
                    @FormatUtc(sourceRefresh)
                </time>
            }
            else
            {
                <span>Unavailable.</span>
            }
            This is not the selected-corpus ticket date.
        </p>

        @if (discussionPublication.Manifest.DiscussionCorpus is
            DiscussionCorpusSummary corpus)
        {
            <div class="publication-corpus-evidence">
                <h3 class="h6">Selected-corpus dates</h3>
                <p>
                    Frozen, generation-filtered projection:
                    <strong>@corpus.TicketCount tickets</strong> across
                    @corpus.ExportedProjectCount projects.
                    Browser filters do not change these facts or the frozen title.
                </p>
                <dl class="row">
                    <dt class="col-sm-6">Date coverage</dt>
                    <dd class="col-sm-6"><code>@corpus.DateCoverage</code></dd>
                    <dt class="col-sm-6">Valid self-ticket Jira dates</dt>
                    <dd class="col-sm-6">@corpus.ValidJiraUpdatedAtCount / @corpus.TicketCount tickets</dd>
                    <dt class="col-sm-6">Maximum known self-ticket Jira update</dt>
                    <dd class="col-sm-6">
                        @if (corpus.MaxJiraUpdatedAt is DateTimeOffset maximum)
                        {
                            <time datetime="@maximum.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">
                                @FormatUtc(maximum)
                            </time>
                        }
                        else
                        {
                            <span>Unavailable; no valid self-ticket date is recorded.</span>
                        }
                    </dd>
                </dl>
                <p class="text-body-secondary">
                    @if (corpus.DateCoverage == DiscussionDateCoverage.Complete)
                    {
                        <span>
                            Complete selected-corpus dates supply the ticket-date
                            title suffix independently of provenance readiness.
                        </span>
                    }
                    else
                    {
                        <span>
                            Empty or incomplete date coverage does not supply a
                            ticket-date title suffix, even when a partial maximum
                            is known.
                        </span>
                    }
                </p>

                <h3 class="h6">Public-name coverage</h3>
                <dl class="row">
                    <dt class="col-sm-6">Reporter</dt>
                    <dd class="col-sm-6">@corpus.TicketsWithPublicReporter / @corpus.TicketCount tickets</dd>
                    <dt class="col-sm-6">Assignee</dt>
                    <dd class="col-sm-6">@corpus.TicketsWithPublicAssignee / @corpus.TicketCount tickets</dd>
                    <dt class="col-sm-6">In-person requester</dt>
                    <dd class="col-sm-6">@corpus.TicketsWithPublicRequester / @corpus.TicketCount tickets</dd>
                </dl>
                <p class="text-body-secondary">
                    Counts measure tickets with public names, not distinct people.
                    An empty Assignee does not establish whether someone is assigned.
                    A current policy marker does not prove a display name exists
                    or that a role is absent.
                </p>

                <h3 class="h6">Link coverage</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <caption>Related-item rows by kind, not ticket counts.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Kind</th>
                                <th scope="col">Total rows</th>
                                <th scope="col">Resolved safe links</th>
                                <th scope="col">Unresolved with retained safe URLs</th>
                                <th scope="col">Without usable URL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DiscussionLinkCoverage links in corpus.LinksByKind)
                            {
                                <tr>
                                    <th scope="row"><code>@links.Kind</code></th>
                                    <td>@links.TotalRows</td>
                                    <td>@links.ResolvedSafeLinks</td>
                                    <td>@links.UnresolvedWithRetainedSafeLinks</td>
                                    <td>@links.WithoutUsableUrl</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-body-secondary">
                    A retained safe URL does not certify current resolution or
                    source backing. Review the link's lookup diagnostics for
                    last-known or unverified context.
                </p>
            </div>
        }
        else
        {
            <div class="callout callout--neutral publication-corpus-evidence">
                <i class="bi bi-question-circle" aria-hidden="true"></i>
                <div>
                    <strong>Selected-corpus coverage is unavailable.</strong>
                    This legacy publication does not record date, public-name,
                    or link coverage. Counts and the maximum self-ticket Jira
                    update are unknown, not zero; its stored title is unchanged.
                </div>
            </div>
        }
    }

    @if (LastResult?.Disposition ==
        TicketOperationDisposition.Failed)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Site publication failed.</strong>
            @LastResult.Message
            @if (LastResult.VerifiedPairAvailable)
            {
                <span class="d-block mt-1">
                    The verified snapshot pair remains available, so retrying
                    will not replay processor authoring work.
                </span>
            }
            <span class="d-block mt-1">
                The processor result shown above is unchanged.
            </span>
        </div>
    }
    else if (LastResult is not null &&
        LastResult.Disposition !=
            TicketOperationDisposition.Succeeded)
    {
        <div class="alert alert-warning" role="status">
            <strong>Site generation was not started.</strong>
            @LastResult.Message
            <span class="d-block mt-1">
                The processor result shown above is unchanged.
            </span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        Details.PublicationError))
    {
        <div class="alert alert-warning" role="alert">
            <strong>Existing site could not be reconstructed.</strong>
            @Details.PublicationError
            <span class="d-block mt-1">
                The processor result shown above is unchanged.
            </span>
        </div>
    }

    @if (LastResult?.Warnings is { Count: > 0 } warnings)
    {
        <div class="callout callout--warning">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <div>
                <strong>Publication warnings</strong>
                <ul class="mb-0">
                    @foreach (string warning in warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (CanRefreshPublication)
    {
        <div class="publication-panel__actions">
            <button class="btn btn-primary"
                    type="button"
                    disabled="@(Busy || Refreshing || Disabled || RefreshDisabled)"
                    @onclick="RefreshPublicationAsync">
                @if (Refreshing)
                {
                    <span class="spinner-border spinner-border-sm"
                          aria-hidden="true"></span>
                    <span>Starting publication refresh…</span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    <span>Refresh publication data and snapshot</span>
                }
            </button>
            <p class="form-text mb-0">
                This starts one linked Preparer maintenance run. It does not
                replay authoring or grouping; publish the returned run's
                verified pair as a separate step.
            </p>
            <p class="form-text mb-0">
                Source people population is separate. In the
                <a href="/api-test?source=Jira">Jira API catalog</a>,
                use <strong>Preview public people population</strong>, inspect
                the evidence and shared-user effects, then explicitly
                <strong>Apply public people population</strong> when eligible.
                This refresh never performs source backfill.
            </p>
        </div>
    }
    @if (CanPublish)
    {
        <div class="publication-panel__actions">
            <button @ref="_primaryAction"
                    class="btn btn-primary"
                    type="button"
                    disabled="@(Busy || Refreshing || Disabled || _confirmingReplacement)"
                    @onclick="PublishPrimaryAsync">
                @if (Busy)
                {
                    <span class="spinner-border spinner-border-sm"
                          aria-hidden="true"></span>
                    <span>Generating site…</span>
                }
                else if (Publication is not null)
                {
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    <span>Regenerate review site</span>
                }
                else if (LastResult?.Disposition ==
                    TicketOperationDisposition.Failed ||
                    HasReconstructionFailure)
                {
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    <span>Retry without replacing output</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-code-fill"
                       aria-hidden="true"></i>
                    <span>Generate review site</span>
                }
            </button>
            @if (ShowReplacementRecovery)
            {
                <button @ref="_replacementTrigger"
                        class="btn btn-outline-danger"
                        type="button"
                        disabled="@(Busy || Refreshing || Disabled || _confirmingReplacement)"
                        aria-expanded="@_confirmingReplacement"
                        aria-controls="@ReplacementPanelId"
                        @onclick="BeginReplacementAsync">
                    <i class="bi bi-exclamation-diamond"
                       aria-hidden="true"></i>
                    Replace existing output…
                </button>
            }
            <p class="form-text mb-0">
                Generation runs in this Dev UI process. It does not launch
                another server process or replay ticket authoring.
                It uses this run's frozen snapshot, not current source data.
            </p>
        </div>

        @if (_confirmingReplacement)
        {
            <div id="@ReplacementPanelId"
                 class="publication-replacement-confirmation"
                 role="group"
                 aria-busy="@ReplacementAttemptBusy"
                 aria-labelledby="@ReplacementHeadingId">
                <h3 id="@ReplacementHeadingId" class="h6">
                    Replace this run's existing review-site output?
                </h3>
                <p>
                    Normal generation will not overwrite output that it
                    cannot verify. This explicit forced regeneration may
                    take ownership of, or replace, files already present in
                    this run-scoped site directory.
                </p>
                <p>
                    Continue only after verifying that the existing local
                    output can be discarded. The replacement is staged and
                    validated before publication; processor authoring is not
                    replayed and the processor result remains unchanged.
                </p>
                <div class="publication-replacement-confirmation__actions">
                    <button @ref="_replacementConfirm"
                            class="btn btn-sm btn-danger"
                            type="button"
                            disabled="@(ReplacementAttemptBusy || Disabled)"
                            @onclick="ConfirmReplacementAsync">
                        @if (ReplacementAttemptBusy)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  aria-hidden="true"></span>
                            <span>Replacing output…</span>
                        }
                        else
                        {
                            <span>Replace and regenerate site</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            disabled="@(ReplacementAttemptBusy || Disabled)"
                            @onclick="CancelReplacementAsync">
                        Cancel
                    </button>
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public TicketRunDetails Details { get; set; } = null!;

    [Parameter]
    public TicketPublicationResult? LastResult { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool Refreshing { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool RefreshDisabled { get; set; }

    [Parameter]
    public EventCallback<bool> OnPublish { get; set; }

    [Parameter]
    public EventCallback OnRefreshPublication { get; set; }

    private readonly string _id =
        Guid.NewGuid().ToString("N");
    private ElementReference _primaryAction;
    private ElementReference _replacementTrigger;
    private ElementReference _replacementConfirm;
    private bool _confirmingReplacement;
    private bool _focusPrimaryAction;
    private bool _focusReplacementConfirm;
    private bool _replacementAttemptActive;

    private string HeadingId =>
        $"run-{Details.Response.Run.RunId.GetHashCode(StringComparison.Ordinal):x}-publication";

    private string ReplacementPanelId =>
        $"publication-replacement-{_id}";

    private string ReplacementHeadingId =>
        $"{ReplacementPanelId}-heading";

    private ReviewSitePublication? Publication =>
        Details.Publication ?? LastResult?.Publication;

    private IReadOnlyList<AuthoringRunItemStatus> SupersededItems =>
        Details.Response.Items
            .Where(item => string.Equals(
                item.Status,
                "superseded",
                StringComparison.OrdinalIgnoreCase))
            .ToArray();

    private bool CanPublish =>
        Details.Outcome.Processor is
            ProcessorRunOutcome.Completed or
            ProcessorRunOutcome.CompletedWithSupersededItems &&
        !Details.Response.Run.DatabaseOnly;

    private bool CanRefreshPublication =>
        Details.Workflow.SiteKind == TicketSiteKind.Discussion &&
        string.Equals(
            Details.Workflow.ProcessingServiceName,
            "Preparer",
            StringComparison.Ordinal) &&
        Publication is not null &&
        CanPublish &&
        !string.Equals(
            Details.Response.Run.Purpose,
            PreparedTicketPublicationContract.PublicationRefreshPurpose,
            StringComparison.Ordinal);

    private bool HasReconstructionFailure =>
        !string.IsNullOrWhiteSpace(
            Details.PublicationError);

    private bool ShowReplacementRecovery =>
        Publication is null &&
        (HasReconstructionFailure ||
            LastResult?.Disposition ==
                TicketOperationDisposition.Failed);

    private bool ReplacementAttemptBusy =>
        Busy || Refreshing || _replacementAttemptActive;

    private static string FormatUtc(DateTimeOffset value) =>
        value.ToUniversalTime().ToString(
            "yyyy-MM-dd HH:mm:ss 'UTC'",
            CultureInfo.InvariantCulture);

    private string PublicationStatus
    {
        get
        {
            if (Refreshing)
            {
                return "refreshing";
            }
            if (Busy)
            {
                return "publishing";
            }
            if (LastResult?.Disposition ==
                TicketOperationDisposition.Failed ||
                !string.IsNullOrWhiteSpace(
                    Details.PublicationError))
            {
                return "failed";
            }
            if (LastResult is not null &&
                LastResult.Disposition !=
                    TicketOperationDisposition.Succeeded)
            {
                return "warning";
            }
            return Publication is null
                ? CanPublish
                    ? "ready"
                    : "unavailable-for-publication"
                : "published";
        }
    }

    private string PublicationLabel =>
        PublicationStatus switch
        {
            "refreshing" => "Starting refresh",
            "publishing" => "Generating",
            "failed" => "Publication failed",
            "warning" => "Not started",
            "ready" => "Ready to generate",
            "published" => "Published",
            _ => "Not available",
        };

    private string ProcessorResultLabel =>
        Details.Outcome.Processor switch
        {
            ProcessorRunOutcome.Active => "Processing active",
            ProcessorRunOutcome.RecoverableError =>
                "Recoverable error; still non-terminal",
            ProcessorRunOutcome.Completed => "Full success",
            ProcessorRunOutcome.CompletedWithSupersededItems =>
                "Partial success with superseded tickets",
            ProcessorRunOutcome.CompletedDatabaseOnly =>
                "Database-only success",
            ProcessorRunOutcome.Superseded => "Run superseded",
            _ => Details.Outcome.Processor.ToString(),
        };

    protected override void OnParametersSet()
    {
        if (!ReplacementAttemptBusy &&
            !ShowReplacementRecovery)
        {
            _confirmingReplacement = false;
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (_focusReplacementConfirm)
        {
            _focusReplacementConfirm = false;
            await _replacementConfirm.FocusAsync(
                preventScroll: true);
        }
        else if (_focusPrimaryAction &&
            !Busy &&
            !Disabled)
        {
            _focusPrimaryAction = false;
            await _primaryAction.FocusAsync(
                preventScroll: true);
        }
    }

    private Task PublishPrimaryAsync() =>
        OnPublish.InvokeAsync(Publication is not null);

    private Task RefreshPublicationAsync() =>
        OnRefreshPublication.InvokeAsync();

    private Task BeginReplacementAsync()
    {
        _confirmingReplacement = true;
        _focusReplacementConfirm = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmReplacementAsync()
    {
        if (ReplacementAttemptBusy || Disabled)
        {
            return;
        }

        _replacementAttemptActive = true;
        try
        {
            await OnPublish.InvokeAsync(true);
        }
        finally
        {
            _replacementAttemptActive = false;
            _confirmingReplacement = false;
            _focusPrimaryAction = true;
        }
    }

    private async Task CancelReplacementAsync()
    {
        if (ReplacementAttemptBusy || Disabled)
        {
            return;
        }

        _confirmingReplacement = false;
        await InvokeAsync(StateHasChanged);
        await _replacementTrigger.FocusAsync(
            preventScroll: true);
    }
}
