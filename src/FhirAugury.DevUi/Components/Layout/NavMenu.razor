@inject IJSRuntime JS

<div class="app-navigation">
    <ul class="navbar-nav" aria-label="Workspace sections">
        <li class="nav-item">
            <NavLink class="nav-link"
                     href="/"
                     Match="NavLinkMatch.All"
                     @onclick="NotifyNavigationAsync">
                <i class="bi bi-kanban-fill" aria-hidden="true"></i>
                Operations
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link"
                     href="/services"
                     @onclick="NotifyNavigationAsync">
                <i class="bi bi-hdd-stack-fill" aria-hidden="true"></i>
                Services
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link"
                     href="/api-test"
                     @onclick="NotifyNavigationAsync">
                <i class="bi bi-terminal-fill" aria-hidden="true"></i>
                API Tests
            </NavLink>
        </li>
    </ul>

    <button class="btn theme-toggle"
            type="button"
            title="@ThemeButtonLabel"
            aria-label="@ThemeButtonLabel"
            aria-pressed="@_isDark"
            @onclick="ToggleThemeAsync">
        <i class="bi @(_isDark ? "bi-sun-fill" : "bi-moon-stars-fill")"
           aria-hidden="true"></i>
        <span>@(_isDark ? "Light theme" : "Dark theme")</span>
    </button>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _isDark;

    private string ThemeButtonLabel =>
        _isDark
            ? "Switch to light theme"
            : "Switch to dark theme";

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string theme =
            await JS.InvokeAsync<string>("getTheme");
        _isDark = string.Equals(
            theme,
            "dark",
            StringComparison.Ordinal);
        StateHasChanged();
    }

    private Task NotifyNavigationAsync() =>
        OnNavigate.InvokeAsync();

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync(
            "setTheme",
            _isDark ? "dark" : "light");
    }
}
