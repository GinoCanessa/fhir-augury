@page "/services"
@inject OrchestratorClient Orchestrator

<PageTitle>Services — FHIR Augury Dev UI</PageTitle>

<div class="page-heading">
    <div>
        <p class="page-heading__eyebrow">Diagnostics</p>
        <h1>Service dashboard</h1>
        <p class="page-heading__summary">
            Inspect Orchestrator observations and manage source indexes.
        </p>
    </div>
    <button class="btn btn-outline-primary"
            type="button"
            disabled="@_loading"
            @onclick="LoadDataAsync">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true"></span>
        }
        else
        {
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        }
        Refresh
    </button>
</div>

@if (_loading && _services.Count == 0)
{
    <div class="loading-state" role="status">
        <span class="spinner-border" aria-hidden="true"></span>
        <span>Loading service status…</span>
    </div>
}
else if (_error is not null && _services.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>
            <strong>Error connecting to the Orchestrator.</strong>
            <span class="d-block">@_error</span>
        </div>
    </div>
    <button class="btn btn-outline-primary"
            type="button"
            @onclick="LoadDataAsync">
        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        Retry
    </button>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Refresh failed.</strong> @_error
        </div>
    }

    @if (_actionError is not null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Index action failed.</strong> @_actionError
        </div>
    }

    <div class="table-responsive service-table">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">
                Orchestrator, source, and processing service observations
            </caption>
            <thead class="table-dark">
                <tr>
                    <th scope="col">Service</th>
                    <th scope="col">Address</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Items</th>
                    <th scope="col" class="text-end">DB size</th>
                    <th scope="col">Last sync</th>
                    <th scope="col">Last error</th>
                    <th scope="col">Indexes</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ServiceHealthInfo service in OrderedServices)
                {
                    <tr>
                        <th scope="row">
                            <span class="service-name">
                                <i class="bi @ServiceIcon(service.ServiceKind)"
                                   aria-hidden="true"></i>
                                @service.Name
                            </span>
                            <span class="d-block text-body-secondary small">
                                @ServiceKindLabel(service.ServiceKind)
                            </span>
                        </th>
                        <td>
                            <code>@ServiceAddress(service)</code>
                        </td>
                        <td>
                            <StatusIndicator Status="@service.Status" />
                            @if (string.Equals(
                                service.ServiceKind,
                                "processing",
                                StringComparison.OrdinalIgnoreCase) &&
                                !string.IsNullOrWhiteSpace(
                                    service.ProcessingStatus))
                            {
                                <span class="d-block small text-body-secondary">
                                    Lifecycle: @service.ProcessingStatus
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            @if (string.Equals(
                                service.ServiceKind,
                                "processing",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span title="Remaining processing items">
                                    @(service.ProcessingRemainingCount?.ToString("N0") ?? "—")
                                </span>
                            }
                            else
                            {
                                @service.ItemCount.ToString("N0")
                            }
                        </td>
                        <td class="text-end">
                            @FormatBytes(service.DbSizeBytes)
                        </td>
                        <td>@FormatTimestamp(service.LastSyncAt)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(service.LastError))
                            {
                                <span class="text-danger"
                                      title="@service.LastError">
                                    <i class="bi bi-exclamation-circle"
                                       aria-hidden="true"></i>
                                    @Truncate(service.LastError, 40)
                                </span>
                            }
                            else
                            {
                                <span class="text-body-secondary">—</span>
                            }
                        </td>
                        <td>
                            @if (service.Indexes is { Count: > 0 })
                            {
                                int rebuilding =
                                    service.Indexes.Count(
                                        index => index.IsRebuilding);
                                <button class="btn btn-sm btn-outline-info"
                                        type="button"
                                        @onclick="() => ToggleIndexes(service.Name)"
                                        aria-expanded="@_expandedIndexes.Contains(service.Name)"
                                        aria-controls="@IndexPanelId(service.Name)">
                                    @service.Indexes.Count indexes
                                    @if (rebuilding > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">
                                            @rebuilding rebuilding
                                        </span>
                                    }
                                </button>
                            }
                            else
                            {
                                <span class="text-body-secondary">—</span>
                            }
                        </td>
                        <td>
                            @if (string.Equals(
                                service.ServiceKind,
                                "source",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <a class="btn btn-sm btn-primary"
                                   href="@($"/api-test?source={Uri.EscapeDataString(service.Name)}")">
                                    <i class="bi bi-terminal" aria-hidden="true"></i>
                                    API Tests
                                </a>
                            }
                            else if (string.Equals(
                                service.ServiceKind,
                                "processing",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   href="/">
                                    <i class="bi bi-kanban" aria-hidden="true"></i>
                                    Operations
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-primary"
                                   href="/api-test">
                                    <i class="bi bi-terminal" aria-hidden="true"></i>
                                    API Tests
                                </a>
                            }
                        </td>
                    </tr>

                    @if (_expandedIndexes.Contains(service.Name) &&
                        service.Indexes is { Count: > 0 })
                    {
                        <tr>
                            <td colspan="9"
                                class="bg-body-secondary p-0">
                                <div id="@IndexPanelId(service.Name)"
                                     class="index-panel">
                                    <div class="index-panel__heading">
                                        <h2 class="h6 mb-0">
                                            Indexes — @service.Name
                                        </h2>
                                        @{
                                            string allKey =
                                                RebuildKey(
                                                    service.Name,
                                                    "all");
                                            string allIndexType = "all";
                                            bool allRebuilding =
                                                _rebuildingKeys.Contains(
                                                    allKey);
                                        }
                                        <button class="btn btn-sm btn-outline-warning"
                                                type="button"
                                                disabled="@allRebuilding"
                                                @onclick="() => RebuildIndexAsync(service.Name, allIndexType)">
                                            @if (allRebuilding)
                                            {
                                                <span class="spinner-border spinner-border-sm"
                                                      aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-repeat"
                                                   aria-hidden="true"></i>
                                            }
                                            Rebuild all
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Name</th>
                                                    <th scope="col">Description</th>
                                                    <th scope="col">Status</th>
                                                    <th scope="col" class="text-end">Records</th>
                                                    <th scope="col">Last rebuild</th>
                                                    <th scope="col">Error</th>
                                                    <th scope="col">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (IndexStatusInfo index in service.Indexes)
                                                {
                                                    string key =
                                                        RebuildKey(
                                                            service.Name,
                                                            index.Name);
                                                    bool requested =
                                                        _rebuildingKeys.Contains(
                                                            key);
                                                    <tr>
                                                        <th scope="row">
                                                            <code>@index.Name</code>
                                                        </th>
                                                        <td>@index.Description</td>
                                                        <td>
                                                            <StatusIndicator Status="@(index.IsRebuilding ? "running" : "ready")"
                                                                             Label="@(index.IsRebuilding ? "Rebuilding" : "Ready")" />
                                                        </td>
                                                        <td class="text-end">
                                                            @index.RecordCount.ToString("N0")
                                                        </td>
                                                        <td>
                                                            @FormatTimestamp(index.LastRebuildCompletedAt)
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(index.LastError))
                                                            {
                                                                <span class="text-danger"
                                                                      title="@index.LastError">
                                                                    <i class="bi bi-exclamation-circle"
                                                                       aria-hidden="true"></i>
                                                                    @Truncate(index.LastError, 30)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-body-secondary">—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-warning"
                                                                    type="button"
                                                                    disabled="@(requested || allRebuilding)"
                                                                    @onclick="() => RebuildIndexAsync(service.Name, index.Name)">
                                                                @if (requested)
                                                                {
                                                                    <span class="spinner-border spinner-border-sm"
                                                                          aria-hidden="true"></span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-arrow-repeat"
                                                                       aria-hidden="true"></i>
                                                                }
                                                                Rebuild
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private List<ServiceHealthInfo> _services = [];
    private readonly HashSet<string> _expandedIndexes =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _rebuildingKeys =
        new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<ServiceHealthInfo> OrderedServices =>
        _services
            .OrderBy(service => ServiceOrder(service.ServiceKind))
            .ThenBy(service => service.Name);

    protected override Task OnInitializedAsync() =>
        LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _services = await Orchestrator.GetServicesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleIndexes(string serviceName)
    {
        if (!_expandedIndexes.Remove(serviceName))
        {
            _expandedIndexes.Add(serviceName);
        }
    }

    private static string RebuildKey(
        string service,
        string indexType) =>
        $"{service}:{indexType}";

    private async Task RebuildIndexAsync(
        string service,
        string indexType)
    {
        string key = RebuildKey(service, indexType);
        _rebuildingKeys.Add(key);
        _actionError = null;
        try
        {
            await Orchestrator.RebuildIndexAsync(
                service,
                indexType);
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _rebuildingKeys.Remove(key);
            await LoadDataAsync();
        }
    }

    private string ServiceAddress(ServiceHealthInfo service) =>
        service.HttpAddress ??
        (string.Equals(
            service.ServiceKind,
            "orchestrator",
            StringComparison.OrdinalIgnoreCase)
            ? Orchestrator.Address
            : "—");

    private static int ServiceOrder(string kind) =>
        kind.ToLowerInvariant() switch
        {
            "orchestrator" => 0,
            "source" => 1,
            "processing" => 2,
            _ => 3,
        };

    private static string ServiceKindLabel(string kind) =>
        kind.ToLowerInvariant() switch
        {
            "orchestrator" => "Gateway",
            "processing" => "Processor",
            "source" => "Source",
            _ => kind,
        };

    private static string ServiceIcon(string kind) =>
        kind.ToLowerInvariant() switch
        {
            "orchestrator" => "bi-diagram-3",
            "processing" => "bi-cpu",
            _ => "bi-database",
        };

    private static string IndexPanelId(string serviceName) =>
        $"indexes-{serviceName.GetHashCode(StringComparison.Ordinal):x}";

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
        {
            return "—";
        }
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:F1} {units[unit]}";
    }

    private static string FormatTimestamp(
        DateTimeOffset? timestamp)
    {
        if (timestamp is null)
        {
            return "—";
        }
        TimeSpan age = DateTimeOffset.UtcNow - timestamp.Value;
        if (age >= TimeSpan.Zero && age.TotalMinutes < 1)
        {
            return "just now";
        }
        if (age >= TimeSpan.Zero && age.TotalHours < 1)
        {
            return $"{(int)age.TotalMinutes} min ago";
        }
        if (age >= TimeSpan.Zero && age.TotalDays < 1)
        {
            return $"{(int)age.TotalHours} hr ago";
        }
        return timestamp.Value.LocalDateTime.ToString("g");
    }

    private static string Truncate(
        string text,
        int maxLength) =>
        text.Length <= maxLength
            ? text
            : string.Concat(
                text.AsSpan(0, maxLength),
                "…");
}
