@page "/"
@implements IDisposable
@inject TicketOperationsService Operations

<PageTitle>Operations — FHIR Augury Dev UI</PageTitle>

<div class="page-heading">
    <div>
        <p class="page-heading__eyebrow">Guided ticket processing</p>
        <h1>Operations workspace</h1>
        <p class="page-heading__summary">
            Prepare discussion tickets and plan application work through
            processor-owned, resumable runs.
        </p>
    </div>
    <button class="btn btn-outline-primary"
            type="button"
            disabled="@_loading"
            @onclick="RecheckAsync">
        @if (_loading && _overview is not null)
        {
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true"></span>
        }
        else
        {
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        }
        Refresh and recheck
    </button>
</div>

<div class="workspace-boundary">
    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
    <span>
        This workspace creates and recovers ticket runs. Use the Aspire
        dashboard to start or stop the Orchestrator, source services, and
        processors, and to inspect their logs and traces.
    </span>
</div>

<div class="operation-announcer"
     aria-live="polite"
     aria-atomic="true">
    @if (_loading)
    {
        <span>
            @(_overview is null
                ? "Loading operations and service observations."
                : "Refreshing operations and rechecking service observations.")
        </span>
    }
    else if (_refreshedAt is DateTimeOffset refreshedAt)
    {
        <span>
            Operations refreshed
            <time datetime="@refreshedAt.ToString("O")">
                @refreshedAt.LocalDateTime.ToString("T")
            </time>.
        </span>
    }
</div>

@if (_overview is null && _loading)
{
    <div class="loading-state" role="status">
        <span class="spinner-border" aria-hidden="true"></span>
        <span>Loading operations workspace…</span>
    </div>
}
else if (_error is not null && _overview is null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
        <div>
            <strong>Operations could not be loaded.</strong>
            <span class="d-block">@_error</span>
        </div>
    </div>
    <button class="btn btn-primary"
            type="button"
            @onclick="LoadAsync">
        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        Try again
    </button>
}
else if (_overview is not null)
{
    @if (_error is not null)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div>
                <strong>The latest recheck failed.</strong>
                The previously loaded run information remains visible.
                <span class="d-block">@_error</span>
            </div>
        </div>
    }

    <section class="overview-section"
             aria-labelledby="readiness-heading">
        <div class="section-heading">
            <div>
                <p class="section-heading__eyebrow">Current observations</p>
                <h2 id="readiness-heading">Workflow readiness</h2>
            </div>
            <p>
                Readiness is evidence from the Orchestrator, not a resource
                lifecycle control.
            </p>
        </div>
        <div class="readiness-grid">
            @foreach (WorkflowRunOverview workflow in _overview.Workflows)
            {
                <ReadinessStrip Readiness="@workflow.Readiness" />
            }
        </div>
    </section>

    <section class="overview-section"
             aria-labelledby="workflows-heading">
        <div class="section-heading">
            <div>
                <p class="section-heading__eyebrow">Choose a task</p>
                <h2 id="workflows-heading">Ticket workflows</h2>
            </div>
            <p>
                Active and recovering runs appear before recent terminal
                history.
            </p>
        </div>
        <div class="workflow-grid">
            @foreach (WorkflowRunOverview workflow in _overview.Workflows)
            {
                <WorkflowCard Overview="@workflow" />
            }
        </div>
    </section>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private TicketOperationsOverview? _overview;
    private string? _error;
    private bool _loading = true;
    private DateTimeOffset? _refreshedAt;

    protected override Task OnInitializedAsync() =>
        LoadOverviewAsync(refreshReadiness: false);

    private Task LoadAsync() =>
        LoadOverviewAsync(refreshReadiness: false);

    private Task RecheckAsync() =>
        LoadOverviewAsync(refreshReadiness: true);

    private async Task LoadOverviewAsync(
        bool refreshReadiness)
    {
        if (_loading && _overview is not null)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            TicketOperationsOverview overview =
                await Operations.GetOverviewAsync(
                    refreshReadiness,
                    _lifetime.Token);
            _overview = overview;
            _refreshedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
            when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
