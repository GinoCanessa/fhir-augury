@page "/"
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject TicketWorkflowCatalog Catalog
@inject ILogger<Home> Logger

<PageTitle>Operations — FHIR Augury Dev UI</PageTitle>

<div class="page-heading">
    <div>
        <p class="page-heading__eyebrow">Guided ticket processing</p>
        <h1>Operations workspace</h1>
        <p class="page-heading__summary">
            Prepare discussion tickets and plan application work through
            processor-owned, resumable runs.
        </p>
    </div>
    <button class="btn btn-outline-primary"
            type="button"
            @onclick="RefreshAll">
        @if (InProgressCount > 0)
        {
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true"></span>
        }
        else
        {
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        }
        Refresh and recheck
    </button>
</div>

<div class="workspace-boundary">
    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
    <span>
        This workspace creates and recovers ticket runs. Use the Aspire
        dashboard to start or stop the Orchestrator, source services, and
        processors, and to inspect their logs and traces.
    </span>
</div>

<div class="operation-announcer"
     aria-live="polite"
     aria-atomic="true">
    @if (InProgressCount > 0)
    {
        <span>
            Workspace observations are in progress.
            Available history and navigation remain usable.
        </span>
    }
    @if (FailureCount > 0)
    {
        <span>
            @FailureCount workspace observation(s) failed or are unavailable.
            Retained history is labeled as stale.
        </span>
    }
    else if (InProgressCount == 0)
    {
        <span>
            All workspace observations have completed.
            Check workflow readiness before starting a run.
        </span>
    }
</div>

<section class="overview-section"
         aria-labelledby="readiness-heading">
    <div class="section-heading">
        <div>
            <p class="section-heading__eyebrow">Current observations</p>
            <h2 id="readiness-heading">Workflow readiness</h2>
        </div>
        <p>
            Readiness is evidence from the Orchestrator, not a resource
            lifecycle control.
        </p>
    </div>
    <div class="readiness-grid">
        @foreach (TicketWorkflowDefinition workflow in Catalog.Workflows)
        {
            <ReadinessObservationPanel @key="workflow.RouteKey"
                                       Workflow="@workflow"
                                       Observation="@_snapshot.ReadinessFor(workflow.RouteKey)" />
        }
    </div>
</section>

<section class="overview-section"
         aria-labelledby="workflows-heading">
    <div class="section-heading">
        <div>
            <p class="section-heading__eyebrow">Choose a task</p>
            <h2 id="workflows-heading">Ticket workflows</h2>
        </div>
        <p>
            Active and recovering runs appear before recent terminal
            history. Each history can be refreshed independently.
        </p>
    </div>
    <div class="workflow-grid">
        @foreach (TicketWorkflowDefinition workflow in Catalog.Workflows)
        {
            <WorkflowCard @key="workflow.RouteKey"
                          Workflow="@workflow"
                          History="@_snapshot.Workflows[workflow.RouteKey].History"
                          Readiness="@_snapshot.ReadinessFor(workflow.RouteKey)"
                          OnRefresh="@(() => RefreshHistory(workflow.RouteKey))" />
        }
    </div>
</section>

@code {
    private AsyncServiceScope? _scope;
    private TicketWorkspaceSession? _session;
    private TicketWorkspaceSnapshot _snapshot = null!;
    private Func<TicketWorkspaceSnapshot, Task>? _changed;
    private bool _started;
    private bool _disposed;

    private IEnumerable<WorkspaceObservationPhase> Phases =>
        _snapshot.Workflows.Values
            .Select(workspace => workspace.History.Phase)
            .Append(_snapshot.Readiness.Phase);

    private int InProgressCount =>
        Phases.Count(phase => phase is
            WorkspaceObservationPhase.Pending or
            WorkspaceObservationPhase.Loading);

    private int FailureCount =>
        Phases.Count(phase => phase is
            WorkspaceObservationPhase.Unavailable or
            WorkspaceObservationPhase.Failed);

    protected override void OnInitialized()
    {
        AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        _scope = scope;
        _session = scope.ServiceProvider
            .GetRequiredService<TicketWorkspaceSession>();
        _snapshot = _session.Snapshot;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_started && !_disposed &&
            _session is TicketWorkspaceSession session)
        {
            _started = true;
            _changed = snapshot => ApplySnapshotAsync(session, snapshot);
            session.Changed += _changed;
            session.Start();
        }
        return Task.CompletedTask;
    }

    private async Task ApplySnapshotAsync(
        TicketWorkspaceSession session,
        TicketWorkspaceSnapshot snapshot)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed || !ReferenceEquals(_session, session) ||
                    snapshot.Revision <= _snapshot.Revision)
                {
                    return;
                }
                _snapshot = snapshot;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Could not render workspace revision {Revision}",
                snapshot.Revision);
        }
    }

    private void RefreshAll()
    {
        if (!_disposed)
        {
            _session?.RefreshAll();
        }
    }

    private void RefreshHistory(string workflow)
    {
        if (!_disposed)
        {
            _session?.RefreshHistory(workflow);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        TicketWorkspaceSession? session = _session;
        Func<TicketWorkspaceSnapshot, Task>? changed = _changed;
        AsyncServiceScope? scope = _scope;
        _session = null;
        _changed = null;
        _scope = null;

        if (session is not null && changed is not null)
        {
            session.Changed -= changed;
        }
        if (scope is AsyncServiceScope ownedScope)
        {
            await ownedScope.DisposeAsync();
        }
    }
}
