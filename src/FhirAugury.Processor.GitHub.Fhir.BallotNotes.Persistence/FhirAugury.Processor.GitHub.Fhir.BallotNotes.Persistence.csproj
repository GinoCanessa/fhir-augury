    <InternalsVisibleTo Include="FhirAugury.Processor.GitHub.Fhir.BallotNotes" />
    <InternalsVisibleTo Include="FhirAugury.Processor.GitHub.Fhir.BallotNotes.Tests" />
    <InternalsVisibleTo Include="notes-site" />
    <InternalsVisibleTo Include="FhirAugury.Tools.NotesSite.Tests" />
  </ItemGroup>
</Project>
