{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Processing": {
    "DatabasePath": "./data/processor.jira.fhir.preparer.db",
    "SyncSchedule": "00:01:00",
    "MaxConcurrentProcessingThreads": 8,
    "StartProcessingOnStartup": true,
    "AuthoringRetryDelay": "00:01:00",
    "AuthoringMaxAttempts": 3,
    "SnapshotDirectory": "./data/snapshots/preparer",
    "SnapshotSchemaVersion": 1,
    "ReconcileSnapshotsOnStartup": true,
    "ActivateRunBackedAuthoring": true,
    "PreCutoverBackupPath": "./data/processor.jira.fhir.preparer.pre-cutover.db",
    "OrchestratorAddress": "http://localhost:5150",
    "Ports": {
      "Http": 5171
    },
    "Hydration": {
      "BackfillOnStartup": true,
      "MaxParallelism": 4
    },
    "Jira": {
      "TicketStatusesToProcess": ["Triaged", "Submitted"],
      "ProjectsToInclude": ["FHIR"],
      "SpecificationsToInclude": ["FHIR Core (FHIR)"],
      "WorkGroupsToInclude": null,
      "TicketTypesToProcess": null,
      "AgentCliCommand": "copilot -p '/ticket-prep {ticketKey}' --allow-all",
      "AuthoringAgentCliCommand": "copilot -p '/ticket-prep {ticketKey}' --allow-all",
      "JiraSourceAddress": "http://localhost:5160",
      "OrchestratorAddress": "http://localhost:5150",
      "DiscoverySource": "DirectJiraSource",
      "SourceTicketShape": "fhir"
    }
  }
}
