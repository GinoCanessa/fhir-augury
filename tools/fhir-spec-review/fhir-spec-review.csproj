<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\common.props" />
  <Import Project="..\..\src\sqlite.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FhirAugury.Tools.FhirSpecReview</RootNamespace>
    <AssemblyName>fhir-spec-review</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="cslightdbgen.sqlitegen" Version="2026.622.1509" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FhirAugury.Source.GitHub\FhirAugury.Source.GitHub.csproj" />
    <ProjectReference Include="..\..\src\FhirAugury.Common\FhirAugury.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FhirAugury.Tools.FhirSpecReview.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Self-contained report SPA (review DB inlined as base64, loaded via sql.js) -->
    <EmbeddedResource Include="web-assets\report\index.template.html" LogicalName="web-assets/report/index.template.html" />
    <EmbeddedResource Include="web-assets\report\app.css" LogicalName="web-assets/report/app.css" />
    <EmbeddedResource Include="web-assets\report\app.js" LogicalName="web-assets/report/app.js" />
    <EmbeddedResource Include="web-assets\report\sql-wasm.js" LogicalName="web-assets/report/sql-wasm.js" />
    <EmbeddedResource Include="web-assets\report\sql-wasm.wasm" LogicalName="web-assets/report/sql-wasm.wasm" />
  </ItemGroup>
</Project>
