<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <LangVersion>14.0</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
        <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.11" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
        <Compile Include="$(MSBuildThisFileDirectory)..\src\SqliteProviderInit.cs"
                 Link="Sqlite\SqliteProviderInit.cs"
                 Condition="'$(IsTestProject)' == 'true'" />
    </ItemGroup>
</Project>
